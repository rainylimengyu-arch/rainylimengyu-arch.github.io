{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-nutrient-library.mjs && node scripts/validate-nutrient-library.mjs && node scripts/export-pairing-library.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "build:github": "npm run build && node scripts/prepare-github-pages.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "sync:resources": "node scripts/sync-nutrient-library.mjs",
    "test:nutrients": "node scripts/validate-nutrient-library.mjs",
    "test:pairings": "node --test tests/pairing-engine.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
